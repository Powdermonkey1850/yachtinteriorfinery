# yif2025: WordPress live site.
# Track everything (core, plugins, themes, all uploads incl. image sizes)
# except credentials, dumps, logs, caches and backups.

# ---- Credentials and environment config ----
/wp-config.php
# Any copy of wp-config.php (wp-config.phpBAK..., wp-config.php.old); keeps wp-config-sample.php
/wp-config.php?*
/wp-config-ddev.php
/.ddev/

# ---- Database dumps and archives ----
*.sql
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zst
*.tar
*.tar.gz

# ---- Logs ----
*.log

# ---- Caches (rebuilt automatically) ----
/wp-content/cache/
/wp-content/et-cache/
/wp-content/advanced-cache.php
/wp-content/wp-rocket-config/

# ---- Backups and update temp folders ----
/wp-content/updraft/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/

# ---- Editor / OS ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*:Zone.Identifier
node_modules/
