# Shared mattcasson rules (Garak management)
############################
# Drupal runtime config
############################

# Environment-specific (never commit)
web/sites/*/settings.php
web/sites/*/settings.production.php
web/sites/*/settings.local.php
web/sites/*/services.yml
web/sites/*/services.local.yml

# Allow defaults
!web/sites/*/default.settings.php
!web/sites/*/default.services.yml



############################
# Drupal files directory
# (KEEP files in repo)

# Not old SYNC
/web/sites/default/files/sync

############################

# Ignore generated/cached subdirectories only
web/sites/*/files/php/
web/sites/*/files/css/
web/sites/*/files/js/
web/sites/*/files/styles/
web/sites/*/files/tmp/
web/sites/default/files/insta-imports/


